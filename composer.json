{
    "name": "buriti/i-educar-laguna-ambiente-package",
    "description": "Auditoria admin e setup Laguna (PE-77/2026): verifica módulos e povoa base de teste completo no i-Educar 2.12.",
    "version": "0.3.14",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "ieducar",
        "buriti",
        "laguna",
        "setup",
        "admin",
        "idiario",
        "2.12"
    ],
    "authors": [
        {
            "name": "Buriti"
        }
    ],
    "require": {
        "php": ">=8.3",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "iEducar\\Packages\\BuritiLagunaAmbiente\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "iEducar\\Packages\\BuritiLagunaAmbiente\\Providers\\LagunaAmbienteServiceProvider"
            ]
        },
        "ieducar": {
            "compatible": [
                "2.12"
            ],
            "min": "2.12.0",
            "notes": "Alvo exclusivo i-Educar 2.12 (PHP ≥ 8.3, Illuminate ^11|^12|^13)."
        },
        "idiario": {
            "compatible": true,
            "via": "API i-Educar 2.12 + SSO (IdiarioPortal)",
            "notes": "Compatível com Portabilis i-Diário no espelho Laguna; frequência/notas via sync do core."
        }
    },
    "config": {
        "sort-packages": true
    }
}
