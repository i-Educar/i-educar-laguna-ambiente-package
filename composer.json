{
    "name": "buriti/i-educar-laguna-ambiente-package",
    "description": "Auditoria admin e setup Laguna (PE-77/2026): verifica módulos e povoa base de teste completo no i-Educar 2.12.",
    "version": "0.1.0",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "keywords": ["ieducar", "buriti", "laguna", "setup", "admin"],
    "authors": [{"name": "Buriti"}],
    "require": {
        "php": ">=8.3",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "iEducar\\Packages\\BuritiLagunaAmbiente\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "iEducar\\Packages\\BuritiLagunaAmbiente\\Providers\\LagunaAmbienteServiceProvider"
            ]
        },
        "ieducar": {
            "compatible": ["2.12"]
        }
    },
    "config": {
        "sort-packages": true
    }
}
